          "query": "SELECT A.Bestellungen_BemerkungenNr, A.Bestellungen_BemerkungenText, A.Bestellungen_BemerkungenMD5\nFROM orderStock.if_bestellungen_bemerkungen as A\nWHERE Bestellungen_BemerkungenText IS NOT NULL AND Bestellungen_BemerkungenText <> '' AND\n  (Bestellungen_BemerkungenText_E IS NULL OR\n   Bestellungen_BemerkungenText_E = '')\nORDER BY A.Bestellungen_BemerkungenNr\nLIMIT 200;"
