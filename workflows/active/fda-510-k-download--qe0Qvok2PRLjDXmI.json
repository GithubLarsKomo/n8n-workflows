      {
        "id": "ad60ca03-1c2b-4143-ad64-8101f1987077",
        "name": "Extract Headers and Lines",
        "parameters": {
          "jsCode": "const text = $json[\"text\"] || \"\";\n\n// alle Zeilen (Windows/Unix)\nconst allLines = text.split(/\\r?\\n/).filter(l => l.trim().length > 0);\n\nif (allLines.length === 0) {\n  return [];\n}\n\n// 1. Zeile = Header\nconst headerLine = allLines[0];\nconst headers = headerLine.split(\"|\").map(h => h.trim());\n\n// Rest = Daten\nconst dataLines = allLines.slice(1);\n\nreturn dataLines.map((line, idx) => ({\n  json: {\n    row: idx + 1,\n    line,\n    headers\n  }\n}));"
        },
        "position": [
          352,
          -64
        ],
        "type": "n8n-nodes-base.code",
        "typeVersion": 2
      },
      {
        "id": "fb1fd34b-6255-4878-8343-9b18bb7e6007",
        "name": "Extract Columns",
        "parameters": {
          "jsCode": "function sqlEscape(v) {\n  if (v === undefined || v === null || v === '') {\n    return \"NULL\";\n  }\n\n  const s = String(v)\n    .replace(/\\\\/g, '\\\\\\\\')   // Backslashes\n    .replace(/'/g, \"''\")     // Single Quotes\n    .replace(/\\u0000/g, '')  // Null Bytes\n    .replace(/\\r?\\n/g, ' ')  // Zeilenumbrüche\n    .replace(/\\t/g, ' ')\n    .trim();\n\n  return `${s}`;\n}\n\nconst line = $json.line || '';\nconst headers = $json.headers || [];\nconst values = line.split('|');\n\nconst out = { row: $json.row };\n\nheaders.forEach((name, idx) => {\n  const key = name || `col_${idx + 1}`;\n  out[key] = sqlEscape(values[idx]);\n});\n\nreturn out;",
          "mode": "runOnceForEachItem"
        },
        "position": [
          560,
          -64
        ],
        "type": "n8n-nodes-base.code",
        "typeVersion": 2
      },
      {
        "id": "80c73a45-db4d-4408-bb33-fde990a8e742",
        "name": "KeyMatch",
        "parameters": {
          "jsCode": "function jsonArray(v) {\n\n  if (v === null || v === undefined || v === '') {\n    return [];\n  }\n\n  if (Array.isArray(v)) {\n    return v;\n  }\n\n  try {\n    const parsed = JSON.parse(v);\n    return Array.isArray(parsed) ? parsed : [];\n  } catch {\n    return [];\n  }\n}\n\nconst keywords = $('DB Seeds')\n  .all()\n  .map(item => {\n\n    const r = item.json;\n\n    return {\n      id: Number(r.id),\n\n      name:\n        String(r.name || '').trim(),\n\n      whitelist:\n        jsonArray(r.whitelist),\n\n      blacklist:\n        jsonArray(r.blacklist)\n    };\n  });\n\nconst productcodes = [\n  \"DBE\",\n  \"DBJ\",\n  \"DBL\",\n  \"DBM\",\n  \"DDN\",\n  \"MID\",\n  \"MOB\",\n  \"MSV\",\n  \"MVJ\",\n  \"MVM\",\n  \"NBO\",\n  \"NBS\",\n  \"NBT\",\n  \"NHX\",\n  \"NIY\",\n  \"NJF\",\n  \"NRI\",\n  \"NST\",\n  \"NUM\",\n  \"NWG\",\n  \"NXO\",\n  \"NYO\",\n  \"OCN\",\n  \"OEG\",\n  \"OIF\",\n  \"OPN\",\n  \"OQZ\",\n  \"OSK\",\n  \"OYL\",\n  \"PAF\",\n  \"PET\",\n  \"PGV\",\n  \"PHF\",\n  \"PIV\",\n  \"SET\",\n];\n\nconst applicant   = ($json.APPLICANT || \"\").toUpperCase();\nconst device      = ($json.DEVICENAME || \"\").toUpperCase();\nconst productcode = ($json.PRODUCTCODE || \"\").toUpperCase().trim();\n\nfunction txtIncludes(text, term) {\n  return text.includes(String(term).toUpperCase());\n}\n\nfunction matchesRule(rule) {\n  // 1. Herstellername muss im APPLICANT vorkommen\n  if (!txtIncludes(applicant, rule.name)) {\n    return false;\n  }\n\n  // 2. Whitelist: wenn vorhanden, mindestens ein Begriff im DEVICENAME\n  if (Array.isArray(rule.whitelist) && rule.whitelist.length > 0) {\n    const anyWhite = rule.whitelist.some(w => txtIncludes(device, w));\n    if (!anyWhite) {\n      return false;\n    }\n  }\n\n  // 3. Blacklist: wenn vorhanden, kein Begriff darf im DEVICENAME vorkommen\n  if (Array.isArray(rule.blacklist) && rule.blacklist.length > 0) {\n    const anyBlack = rule.blacklist.some(b => txtIncludes(device, b));\n    if (anyBlack) {\n      return false;\n    }\n  }\n\n  return true;\n}\n\n// Keyword-Match\nconst matchedKeyword = keywords.find(k => matchesRule(k)) || null;\n\n// Productcode-Match unabhängig vom Keyword-Match\nconst matchedProductcode = productcodes.find(pc => productcode === pc.toUpperCase()) || null;\n\n// Gesamtlogik: true, wenn EINES von beidem matched\nconst overallMatch = Boolean(matchedKeyword || matchedProductcode);\n\nreturn {\n  ...$json,\n\n  keywordMatch: Boolean(matchedKeyword),\n  matchedId: matchedKeyword ? matchedKeyword.id : null,\n  matchedName: matchedKeyword ? matchedKeyword.name : null,\n\n  productcodeMatch: Boolean(matchedProductcode),\n  matchedProductcode: matchedProductcode,\n\n  overallMatch: overallMatch\n};",
          "mode": "runOnceForEachItem"
        },
        "position": [
          768,
          -64
        ],
        "type": "n8n-nodes-base.code",
        "typeVersion": 2
      },
