        "parameters": {
          "operation": "executeQuery",
          "options": {},
          "query": "INSERT IGNORE INTO if_fda (\n  KNUMBER,\n  KFILE_AVAILABLE,\n  APPLICANT_ID,\n  CONTACT,\n  DATERECEIVED,\n  DECISIONDATE,\n  DECISION,\n  REVIEWADVISECOMM,\n  PRODUCTCODE,\n  STATEORSUMM,\n  CLASSADVISECOMM,\n  SSPINDICATOR,\n  TYPE,\n  THIRDPARTY,\n  EXPEDITEDREVIEW,\n  DEVICENAME\n) VALUES (\n  '{{$json[\"KNUMBER\"]}}',\n  'N',\n  {{$json[\"matchedId\"] || \"NULL\"}},\n  '{{$json[\"CONTACT\"]}}',\n  '{{$json[\"DATERECEIVED\"]}}',\n  '{{$json[\"DECISIONDATE\"]}}',\n  '{{$json[\"DECISION\"]}}',\n  '{{$json[\"REVIEWADVISECOMM\"]}}',\n  '{{$json[\"PRODUCTCODE\"]}}',\n  '{{$json[\"STATORSUMM\"] || $json[\"STATEORSUMM\"]}}',\n  '{{$json[\"CLASSADVISECOMM\"]}}',\n  '{{$json[\"SSPINDICATOR\"]}}',\n  '{{$json[\"TYPE\"]}}',\n  '{{$json[\"THIRDPARTY\"]}}',\n  '{{$json[\"EXPEDITEDREVIEW\"]}}',\n  '{{$json[\"DEVICENAME\"]}}'\n);"
