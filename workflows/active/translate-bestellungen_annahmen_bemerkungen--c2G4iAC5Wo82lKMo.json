          "query": "SELECT A.Bestellungen_Annahmen_BemerkungenNr, A.Bestellungen_Annahmen_BemerkungenText, A.Bestellungen_Annahmen_BemerkungenMD5\nFROM orderStock.if_bestellungen_annahmen_bemerkungen as A\nWHERE Bestellungen_Annahmen_BemerkungenText IS NOT NULL AND Bestellungen_Annahmen_BemerkungenText <> '' AND\n  (Bestellungen_Annahmen_BemerkungenText_E IS NULL OR\n   Bestellungen_Annahmen_BemerkungenText_E = '')\nORDER BY A.Bestellungen_Annahmen_BemerkungenNr\nLIMIT 200;"
