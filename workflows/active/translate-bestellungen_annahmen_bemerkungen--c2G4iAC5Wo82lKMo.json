        "id": "2dd5e32e-a106-4422-85c4-28a3162a5dd8",
        "name": "Clean text",
        "parameters": {
          "jsCode": "const text = $json.Bestellungen_BemerkungenText ?? \"\";\n\nlet cleaned = String(text)\n  .replace(/\\\\r\\\\n/g, \"\\n\")\n  .replace(/\\\\n/g, \"\\n\")\n  .replace(/\\r\\n/g, \"\\n\")\n  .replace(/\\r/g, \"\\n\")\n  .replace(/\\u0000/g, \"\")\n  .replace(/[ \\t]{2,}/g, \" \")     // nur Spaces/Tabs\n  .replace(/[ \\t]+$/gm, \"\")\n  .replace(/\\n{3,}/g, \"\\n\\n\")\n  .trim();\n\nif (!cleaned) {\n  return [{ \n    json: {\n      ...$json,\n      skip: true,\n      reason: \"empty_source_text\",\n      text_clean: \"\"\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...$json,\n    skip: false,\n    reason: \"\",\n    text_clean: cleaned\n  }\n}];"
