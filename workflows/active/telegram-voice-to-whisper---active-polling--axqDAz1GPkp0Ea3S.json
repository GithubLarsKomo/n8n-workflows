      {
        "id": "9c6ab7c1-4165-4707-a822-924a6bda4c3b",
        "name": "Extract updates",
        "parameters": {
          "jsCode": "const updates = $json.result || [];\nreturn updates.map(u => {\n  const msg = u.message || {};\n  const voice = msg.voice || null;\n  const audio = msg.audio || null;\n  const document = msg.document || null;\n\n  let file_id = null;\n  let input_type = null;\n\n  if (voice?.file_id) {\n    file_id = voice.file_id;\n    input_type = 'voice';\n  } else if (audio?.file_id) {\n    file_id = audio.file_id;\n    input_type = 'audio';\n  } else if (document?.file_id && String(document.mime_type || '').startsWith('audio/')) {\n    file_id = document.file_id;\n    input_type = 'audio_document';\n  }\n\n  return {\n    json: {\n      update_id: u.update_id,\n      next_offset: Number(u.update_id) + 1,\n      chat_id: msg.chat?.id,\n      message_id: msg.message_id,\n      from_username: msg.from?.username || '',\n      file_id,\n      input_type,\n      has_audio: Boolean(file_id),\n      original_text: msg.text || ''\n    }\n  };\n});"
        },
        "position": [
          -16,
          96
        ],
        "type": "n8n-nodes-base.code",
        "typeVersion": 2
      },
      {
        "id": "b1d99f65-ee5f-4d52-8c96-a493498eb1f3",
