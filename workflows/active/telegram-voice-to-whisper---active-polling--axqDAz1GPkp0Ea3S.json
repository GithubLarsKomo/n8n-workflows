      "name": "Save offset - processed",
      "parameters": {
        "jsCode": "const data = $getWorkflowStaticData('global');\nconst source = $json.next_offset ? $json : $items('Normalize Whisper response')[$itemIndex]?.json || $json;\n\nif (source.next_offset !== undefined) {\n  data.telegram_offset = Math.max(Number(data.telegram_offset || 0), Number(source.next_offset));\n}\n\nreturn [{\n  json: {\n    ok: true,\n    saved_offset: data.telegram_offset,\n    update_id: source.update_id\n  }\n}];"
