      {
        "id": "e3a6c838-41dc-467e-8c8f-93ef67d9eb1e",
        "name": "Normalize Whisper response",
        "parameters": {
          "jsCode": "const meta = $items('Build file URL')[$itemIndex].json;\n\n// Accept common Whisper API shapes:\n// { text: \"...\" }\n// { transcription: \"...\" }\n// { segments: [{text:\"...\"}] }\nlet text = '';\n\nif (typeof $json.text === 'string') {\n  text = $json.text;\n} else if (typeof $json.transcription === 'string') {\n  text = $json.transcription;\n} else if (Array.isArray($json.segments)) {\n  text = $json.segments.map(s => s.text || '').join(' ');\n}\n\ntext = String(text || '').trim();\n\nif (!text) {\n  text = '[Keine Transkription erkannt]';\n}\n\nconst maxLen = 3900;\nconst reply = text.length > maxLen\n  ? text.slice(0, maxLen) + '\\n\\n… [gekürzt]'\n  : text;\n\nreturn [{\n  json: {\n    ...meta,\n    transcription: text,\n    telegram_reply: reply\n  }\n}];"
        },
        "position": [
          1408,
          -32
        ],
        "type": "n8n-nodes-base.code",
        "typeVersion": 2
      },
