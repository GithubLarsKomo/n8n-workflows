      "name": "Build file URL",
      "parameters": {
        "jsCode": "// Preserve metadata and attach Telegram file_path.\nconst src = $items('Extract updates')[$itemIndex].json;\nconst filePath = $json.result?.file_path;\nconst token = $('Token').item.json.TelegramToken;\n\nif (!filePath) {\n  throw new Error('Telegram getFile did not return result.file_path');\n}\n\nreturn [{\n  json: {\n    ...src,\n    file_path: filePath,\n    file_url: `https://api.telegram.org/file/bot${token}/${filePath}`\n  }\n}];"
