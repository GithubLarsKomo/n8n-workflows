        "name": "Prepare offset",
        "parameters": {
          "jsCode": "// Active polling state.\n// Requires workflow static data. Stores last processed Telegram update_id.\nconst data = $getWorkflowStaticData('global');\n\nif (data.telegram_offset === undefined || data.telegram_offset === null) {\n  data.telegram_offset = 0;\n}\n\nreturn [{\n  json: {\n    offset: Number(data.telegram_offset),\n    limit: 20,\n    timeout: 0\n  }\n}];"
