      {
        "id": "3a8a2cb1-c0f5-4930-bedb-36d427293e71",
        "name": "Telegram getUpdates",
        "parameters": {
          "options": {
            "response": {
              "response": {
                "responseFormat": "json"
              }
            }
          },
          "queryParameters": {
            "parameters": [
              {
                "name": "offset",
                "value": "={{ $json.offset }}"
              },
              {
                "name": "limit",
                "value": "={{$json.limit}}"
              },
              {
                "name": "timeout",
                "value": "={{$json.timeout}}"
              },
              {
                "name": "allowed_updates",
                "value": "=[\"message\"]"
              }
            ]
          },
          "sendQuery": true,
          "url": "=https://api.telegram.org/bot{{$('Token').item.json.TelegramToken}}/getUpdates"
        },
