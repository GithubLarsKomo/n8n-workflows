      {
        "id": "bcf5eb91-399d-4107-aac5-f01ce0bb8620",
        "name": "Build Mail Payload",
        "parameters": {
          "jsCode": "const items = $input.all();\n\nconst anzBestellungen = items[0]?.json?.TranslateBestellungen ?? 0;\nconst anzAnnahmen = items[1]?.json?.TranslateAnnahmen ?? 0;\nconst lastFx = items[2]?.json?.AnzTage ?? 0;\n\nconst uservorname = \"Lars\";\nconst to = \"l.komorowski@euroimmun.de\";\n\nlet subject = `Daily Morning Report ${$now.toFormat('yyyy-LL-dd')}`;\nlet text = \"Offene Übersetzungen von Bemerkungen für Bestellungen: \" + anzBestellungen + \"\\n\";\ntext = text + \"Offene Übersetzungen von Bemerkungen für Annahmen: \" + anzAnnahmen + \"\\n\";\ntext = text + \"Tage seit letztem Update FX Rates: \" + lastFx;\nlet html = `<p>Hallo ${uservorname},</p>\n<p>Offene Übersetzungen von Bemerkungen für Bestellungen: ${anzBestellungen}</p>\n<p>Offene Übersetzungen von Bemerkungen für Annahmen: ${anzAnnahmen}</p>\n<p>Tage seit letztem Update FX Rates: ${lastFx}</p>\n<p>Erzeugt am: ${$now.toFormat('dd.LL.yyyy HH:mm:ss')}</p>`;\n\nreturn [\n  {\n    json: {\n      to: [to],\n      cc: [],\n      bcc: [],\n      from: \"infofee@euroimmun.de\",\n      from_name: \"InfoFee Reporting\",\n      subject,\n      text,\n      html,\n      attachments: [\n      ],\n      meta: {\n        generated_at: $now.toISO()\n      }\n    }\n  }\n];"
        },
        "position": [
          -16,
          256
        ],
        "type": "n8n-nodes-base.code",
        "typeVersion": 2
      },
