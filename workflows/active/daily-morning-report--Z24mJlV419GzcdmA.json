        "name": "Letzte FX Raten",
        "parameters": {
          "operation": "executeQuery",
          "options": {},
          "query": "SELECT MAX(FxRateDate) as LastUpdate, NOW(), TO_DAYS(NOW()) - TO_DAYS(MAX(FxRateDate)) as AnzTage\nFROM infofee01_corporate.if_fx_rates"
        },
