      {
        "id": "e406603e-6fa0-43a6-be8d-cba3e08b1737",
        "name": "Normalize Payload",
        "parameters": {
          "jsCode": "const body = $json.body || {};\n\nconst norm = {\n  to: Array.isArray(body.to) ? body.to.filter(v => !!String(v).trim()) : [],\n  cc: Array.isArray(body.cc) ? body.cc.filter(v => !!String(v).trim()) : [],\n  bcc: Array.isArray(body.bcc) ? body.bcc.filter(v => !!String(v).trim()) : [],\n  from: body.from || 'infofee@euroimmun.de',\n  from_name: body.from_name || 'n8n Mail Relay',\n  subject: String(body.subject || '').trim(),\n  text: body.text || '',\n  html: body.html || '',\n  attachments: Array.isArray(body.attachments)\n    ? body.attachments.map(att => ({\n        filename: String(att.filename || '').trim(),\n        mimeType: att.mimeType || 'application/octet-stream',\n        contentBase64: att.contentBase64\n      }))\n    : [],\n  meta: {\n    ...(body.meta || {}),\n    relay_workflow: 'Webhook Mail Relay via PHP Gateway',\n    n8n_execution_id: $execution.id\n  }\n};\n\nreturn [{ json: norm }];"
        },
        "position": [
