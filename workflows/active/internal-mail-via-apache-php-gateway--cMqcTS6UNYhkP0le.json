        "id": "73567285-759d-445d-b0e9-3debb450c9a1",
        "name": "Validate Payload",
        "parameters": {
          "jsCode": "const body = $json.body || {};\nconst errors = [];\n\nif (!Array.isArray(body.to) || body.to.length === 0) {\n  errors.push('Field \"to\" must be a non-empty array');\n}\n\nif (!body.subject || String(body.subject).trim() === '') {\n  errors.push('Field \"subject\" is required');\n}\n\nif ((!body.text || String(body.text).trim() === '') && (!body.html || String(body.html).trim() === '')) {\n  errors.push('Either \"text\" or \"html\" must be provided');\n}\n\nif (body.attachments !== undefined) {\n  if (!Array.isArray(body.attachments)) {\n    errors.push('Field \"attachments\" must be an array');\n  } else {\n    body.attachments.forEach((att, i) => {\n      if (!att || typeof att !== 'object') {\n        errors.push(`Attachment ${i} must be an object`);\n        return;\n      }\n      if (!att.filename || String(att.filename).trim() === '') {\n        errors.push(`Attachment ${i}: filename is required`);\n      }\n      if (!att.contentBase64 || String(att.contentBase64).trim() === '') {\n        errors.push(`Attachment ${i}: contentBase64 is required`);\n      }\n    });\n  }\n}\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    body\n  }\n}];"
        },
        "position": [
          -544,
          576
        ],
        "type": "n8n-nodes-base.code",
        "typeVersion": 2
      },
