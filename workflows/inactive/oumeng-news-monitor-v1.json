    {
      "parameters": {
        "jsCode": "const html = String($json.body ?? $json.data ?? $json ?? '');\nconst data = $getWorkflowStaticData('global');\ndata.seenNewsIds ??= [];\nconst seen = new Set(data.seenNewsIds);\nconst out=[];\nconst re=/href=[\"']([^\"']*\\/frontend\\/news\\/[^\"']+)[\"'][^>]*>([\\s\\S]*?)<\\/a>/gi;\nlet m;\nwhile ((m=re.exec(html))) {\n  const url=new URL(m[1], 'https://oumeng.com.cn').href;\n  const id=url.split('/').filter(Boolean).pop();\n  if (!seen.has(id)) out.push({json:{id,url,title:m[2].replace(/<[^>]+>/g,' ').replace(/\\s+/g,' ').trim()}});\n}\nreturn out.slice(0,1);"
      },
      "id": "extract-new",
      "name": "Extract New News Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
