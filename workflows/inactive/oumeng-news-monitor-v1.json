            }
          }
        }
      },
      "id": "detail",
      "name": "Fetch Detail Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const src=$('Extract New News Items').item.json;\nconst html=String($json.body ?? $json.data ?? '');\nconst text=html.replace(/<script[\\s\\S]*?<\\/script>/gi,' ').replace(/<style[\\s\\S]*?<\\/style>/gi,' ').replace(/<[^>]+>/g,' ').replace(/&nbsp;/g,' ').replace(/&amp;/g,'&').replace(/\\s+/g,' ').trim();\nreturn [{json:{...src,article:text.slice(0,30000)}}];"
      },
      "id": "article",
      "name": "Extract Article Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
