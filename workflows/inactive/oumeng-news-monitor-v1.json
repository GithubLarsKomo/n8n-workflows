        "method": "POST",
        "url": "http://ollama:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model:'hf.co/unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M',stream:false,format:'json',messages:[{role:'system',content:'Translate the Chinese source faithfully into German and provide a concise executive summary. Return JSON with translation_de, summary_de, material.'},{role:'user',content:$json.article}]}) }}",
        "options": {}
      },
      "id": "ollama",
      "name": "Translate + Executive Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const src=$('Extract Article Text').item.json;\nlet a={}; try { a=JSON.parse($json.message?.content ?? '{}'); } catch {}\nreturn [{json:{...src,...a,subject:'Oumeng News: '+(src.title||src.id),body:(a.summary_de||'')+'\\n\\n'+(a.translation_de||'')+'\\n\\nQuelle: '+src.url}}];"
      },
